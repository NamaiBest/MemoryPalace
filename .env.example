# Choose exactly one Memory Guard provider at launch.
MEMORYPALACE_AGENT_PROVIDER=meta
MODEL_API_KEY=
# The same Meta key powers structured video descriptions before Elastic indexing.
META_VIDEO_MODEL=muse-spark-1.3
# Browser voice turns are sent through the backend to Meta Muse Voice Transcribe.
META_VOICE_MODEL=muse-voice-transcribe-1.0
# Optional public-event context. Meta treats this only as a clue and may verify it
# with Responses API web search before the resulting metadata is indexed in Elastic.
MEMORYPALACE_EVENT_CONTEXT=HackMIT 2026 at MIT
META_WEB_SEARCH=1
# XAI_API_KEY=

# Elastic remains the retrieval layer regardless of the selected LLM.
ELASTICSEARCH_URL=https://my-vectordb-project-bece59.es.us-east4.gcp.elastic.cloud
ELASTIC_API_KEY=

# Shared phone/backend authentication. Never commit a real value.
DEMO_TOKEN=
